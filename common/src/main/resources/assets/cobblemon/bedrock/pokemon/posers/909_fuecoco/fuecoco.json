{
    "head": "head",
	"portraitScale": 1.6,
    "portraitTranslation": [ -0.2, -0.2, 0 ],
    "profileScale": 0.65,
    "profileTranslation": [ 0, 0.75, 0 ],
  "animations": {
    "cry": "q.bedrock_stateful('fuecoco', 'cry')"
  },
    "poses": {
      "standing": {
        "poseName": "standing",
        "transformTicks": 10,
        "poseTypes": [
          "STAND",
          "NONE",
          "PORTRAIT",
          "PROFILE"
        ],
        "isBattle": false,
        "animations": [
          "bedrock(fuecoco, ground_idle)"
        ]
      },
      "battle_idle": {
        "poseName": "standing",
        "poseTypes": [
          "STAND"
        ],
        "isBattle": true,
        "animations": ["bedrock(fuecoco, battle_idle)"]
      },
      "walking": {
        "poseName": "walking",
        "transformTicks": 10,
        "poseTypes": [ "WALK" ],
        "animations": [ "bedrock(fuecoco, ground_walk)"
		]
		},
    "flying": {
      "poseName": "flying",
      "transformTicks": 10,
      "poseTypes": [ "FLY" ],
      "animations": [ "bedrock(fuecoco, ground_walk)"
	  ]
    },
	"hovering": {
      "poseName": "hovering",
      "transformTicks": 10,
      "poseTypes": [ "HOVER" ],
      "animations": [ "bedrock(fuecoco, ground_idle)"
	  ]
      },
      "leftshoulder": {
        "poseTypes": ["SHOULDER_LEFT"],
        "animations": ["q.look('fuecoco')", "q.bedrock('fuecoco', 'shoulder_left')"]
      },
      "rightshoulder": {
        "poseTypes": ["SHOULDER_RIGHT"],
        "animations": ["q.bedrock('fuecoco', 'shoulder_right')"]
      }
    }
  }
