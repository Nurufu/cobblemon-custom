    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/lucko/fabric-permissions-api.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/lucko/fabric-permissions-api.git</developerConnection>
